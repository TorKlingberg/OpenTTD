<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets LLDB attach to and pause a running game. Without it `lldb -p <pid>` attaches
	     but cannot stop the process, and the failed attach takes the game down with it. -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
